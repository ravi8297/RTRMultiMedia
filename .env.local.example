# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rtr-media-solutions?retryWrites=true&w=majority&appName=Cluster0

# NextAuth
NEXTAUTH_SECRET=your_random_secret_string_here
NEXTAUTH_URL=http://localhost:3000

# Razorpay (get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend — verification-code email delivery (optional; code is logged to console when unset)
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Sender address; in dev it should be your Resend test domain (re:00xxxx.re.email) or a verified domain
RESEND_FROM=noreply@your-domain.com

# Admin user — required by scripts/createAdmin.js (no hardcoded defaults)
# Set these before running the admin creation script
ADMIN_NAME=RTR Admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change_me_to_a_strong_password